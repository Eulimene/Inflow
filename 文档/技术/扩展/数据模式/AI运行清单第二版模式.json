{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inflow.local/extensions/ai-runtime-manifest-v2.schema.json",
  "title": "Inflow AI Runtime Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "manifestVersion", "authority", "status", "modelStore", "responseOwnership", "costLedger", "memory", "distribution"],
  "properties": {
    "$schema": { "const": "./数据模式/AI运行清单第二版模式.json" },
    "manifestVersion": { "const": 2 },
    "authority": { "const": "normative" },
    "status": { "const": "Accepted" },
    "modelStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerTarget", "addressing", "publisherCannotMutateAfterPublication", "publishSteps", "leaseChecks"],
      "properties": {
        "ownerTarget": { "const": "ai-model-store" },
        "addressing": { "const": "sha256-versioned-cas" },
        "publisherCannotMutateAfterPublication": { "const": true },
        "publishSteps": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "leaseChecks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "responseOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plaintextOwner", "transport", "parserOwner", "diffOwner", "brokerPersistence"],
      "properties": {
        "plaintextOwner": { "const": "main-app" },
        "transport": { "const": "authenticated-bounded-one-shot-stream" },
        "parserOwner": { "const": "main-app" },
        "diffOwner": { "const": "main-app" },
        "brokerPersistence": { "const": "forbidden" }
      }
    },
    "costLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "scope", "protocol", "reservationKey", "unknownPriceRule"],
      "properties": {
        "owner": { "const": "main-app" },
        "scope": { "const": "global-across-windows-and-processes" },
        "protocol": { "const": "atomic-reserve-settle-release" },
        "reservationKey": { "const": "requestID" },
        "unknownPriceRule": { "const": "per-request-confirmation-and-no-auto-continuation" }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumConcurrentWorkers", "singleWorkerPhysicalFraction", "totalAIPhysicalFraction", "absoluteSingleWorkerBytes", "minimumCoreSystemHeadroomBytes", "workingSetSafetyFactor", "admissionRule", "memoryPressureRule"],
      "properties": {
        "maximumConcurrentWorkers": { "type": "integer", "minimum": 1, "maximum": 4 },
        "singleWorkerPhysicalFraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 },
        "totalAIPhysicalFraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 },
        "absoluteSingleWorkerBytes": { "type": "integer", "minimum": 1073741824 },
        "minimumCoreSystemHeadroomBytes": { "type": "integer", "minimum": 2147483648 },
        "workingSetSafetyFactor": { "type": "number", "minimum": 1, "maximum": 2 },
        "admissionRule": { "type": "string", "minLength": 1 },
        "memoryPressureRule": { "type": "string", "minLength": 1 }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "thirdPartyProviders", "developerModeData", "remoteAdapterPolicy"],
      "properties": {
        "phase": { "const": "E4" },
        "thirdPartyProviders": { "const": "E5-or-later" },
        "developerModeData": { "const": "synthetic-fixtures-only" },
        "remoteAdapterPolicy": { "const": "must-have-declared-typed-adapter-policy" }
      }
    }
  }
}
