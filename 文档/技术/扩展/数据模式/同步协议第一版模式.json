{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inflow.local/extensions/sync-protocol-v1.schema.json",
  "title": "Inflow Sync Operation/Receipt/DirtyIntent v1",
  "oneOf": [
    { "$ref": "#/$defs/operation" },
    { "$ref": "#/$defs/receiptEnvelope" },
    { "$ref": "#/$defs/dirtyIntent" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,128}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001F\\u007F]+$", "maxLength": 4096 },
    "hash": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "absent" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision"],
          "properties": {
            "kind": { "const": "exactRevision" },
            "revision": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      ]
    },
    "put": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutationID", "kind", "newPath", "resourceID", "contentHash", "byteCount", "condition"],
      "properties": {
        "mutationID": { "$ref": "#/$defs/id" },
        "kind": { "const": "put" },
        "oldPath": { "$ref": "#/$defs/path" },
        "newPath": { "$ref": "#/$defs/path" },
        "resourceID": { "$ref": "#/$defs/id" },
        "contentHash": { "$ref": "#/$defs/hash" },
        "byteCount": { "type": "integer", "minimum": 0 },
        "condition": { "$ref": "#/$defs/condition" }
      }
    },
    "delete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutationID", "kind", "oldPath", "resourceID", "condition"],
      "properties": {
        "mutationID": { "$ref": "#/$defs/id" },
        "kind": { "const": "delete" },
        "oldPath": { "$ref": "#/$defs/path" },
        "resourceID": { "$ref": "#/$defs/id" },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision"],
          "properties": {
            "kind": { "const": "exactRevision" },
            "revision": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutationID", "kind", "oldPath", "newPath", "resourceID", "contentHash", "condition"],
      "properties": {
        "mutationID": { "$ref": "#/$defs/id" },
        "kind": { "const": "move" },
        "oldPath": { "$ref": "#/$defs/path" },
        "newPath": { "$ref": "#/$defs/path" },
        "resourceID": { "$ref": "#/$defs/id" },
        "contentHash": { "$ref": "#/$defs/hash" },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision"],
          "properties": {
            "kind": { "const": "exactRevision" },
            "revision": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "operationID", "snapshotID", "baselineID", "saveGeneration", "mutations"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "syncOperation" },
        "operationID": { "$ref": "#/$defs/id" },
        "snapshotID": { "$ref": "#/$defs/id" },
        "baselineID": { "$ref": "#/$defs/id" },
        "saveGeneration": { "type": "integer", "minimum": 1 },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "oneOf": [{ "$ref": "#/$defs/put" }, { "$ref": "#/$defs/delete" }, { "$ref": "#/$defs/move" }] }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutationID", "status", "idempotencyReceipt"],
      "properties": {
        "mutationID": { "$ref": "#/$defs/id" },
        "status": { "enum": ["applied", "alreadyApplied", "conflict", "rejected"] },
        "oldPath": { "$ref": "#/$defs/path" },
        "newPath": { "$ref": "#/$defs/path" },
        "remoteRevision": { "type": "string", "minLength": 1, "maxLength": 512 },
        "remoteContentHash": { "$ref": "#/$defs/hash" },
        "idempotencyReceipt": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "receiptEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "operationID", "snapshotID", "policyHash", "receipts"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "syncReceiptEnvelope" },
        "operationID": { "$ref": "#/$defs/id" },
        "snapshotID": { "$ref": "#/$defs/id" },
        "policyHash": { "$ref": "#/$defs/hash" },
        "receipts": { "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": { "$ref": "#/$defs/receipt" } }
      }
    },
    "dirtyIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "workspaceHandle", "saveGeneration", "state"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "syncDirtyIntent" },
        "workspaceHandle": { "$ref": "#/$defs/id" },
        "saveGeneration": { "type": "integer", "minimum": 1 },
        "state": { "const": "rescanRequired" }
      }
    }
  }
}
