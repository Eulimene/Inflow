{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inflow.local/extensions/syntax-contribution-v1.schema.json",
  "title": "Inflow SyntaxContributionSchema v1",
  "oneOf": [
    { "$ref": "#/$defs/fencedBlock" },
    { "$ref": "#/$defs/blockDirective" }
  ],
  "$defs": {
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview", "instantEditing", "export", "diagnostics"],
      "properties": {
        "preview": { "type": "boolean" },
        "instantEditing": { "type": "boolean" },
        "export": { "type": "boolean" },
        "diagnostics": { "type": "boolean" }
      }
    },
    "referenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingID", "role", "attribute", "namespace", "normalization"],
      "properties": {
        "bindingID": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
        "role": { "enum": ["definition", "reference"] },
        "attribute": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$" },
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,127}$" },
        "normalization": { "const": "nfc-case-sensitive" }
      }
    },
    "semanticContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semanticKind", "role", "apiVersion", "priority", "compatibility"],
      "properties": {
        "semanticKind": { "enum": ["MathEnvironment", "Label", "Reference", "Citation", "Theorem", "Bibliography"] },
        "role": { "enum": ["parser", "renderer", "diagnostic", "editor", "exporter"] },
        "apiVersion": { "const": 1 },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "compatibility": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "fencedBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "kind", "names", "nodeType", "contentMode", "fallback", "capabilities"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
        "kind": { "const": "fencedBlock" },
        "names": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_+.-]{0,63}$" } },
        "nodeType": { "const": "fence" },
        "contentMode": { "const": "raw" },
        "fallback": { "const": "codeFence" },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "semanticContributions": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/semanticContribution" } },
        "conflicts": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "blockDirective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "kind", "names", "nodeType", "contentMode", "fallback", "capabilities"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
        "kind": { "const": "blockDirective" },
        "names": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,95}:[a-z][a-z0-9-]{0,31}$" } },
        "nodeType": { "const": "directiveBlock" },
        "contentMode": { "enum": ["raw", "markdownBlocks"] },
        "attributesSchema": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001F\\u007F\\\\]+\\.schema\\.json$", "maxLength": 256 },
        "fallback": { "enum": ["source", "innerMarkdown"] },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "referenceBindings": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/referenceBinding" } },
        "semanticContributions": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/semanticContribution" } },
        "conflicts": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "fallback": { "const": "innerMarkdown" } }, "required": ["fallback"] },
          "then": { "properties": { "contentMode": { "const": "markdownBlocks" } } }
        },
        {
          "if": { "required": ["referenceBindings"] },
          "then": { "required": ["attributesSchema"] }
        }
      ]
    }
  }
}
