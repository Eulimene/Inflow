{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inflow.local/extensions/market-release-record-v1.schema.json",
  "title": "Inflow MarketReleaseRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordVersion", "packageID", "publisherID", "version", "packageSHA256", "contentManifestSHA256", "developerCertificateSHA256", "auditLevel", "channel", "releaseSequence", "minimumInflowBuild", "issuedAt", "status"],
  "properties": {
    "recordVersion": { "const": 1 },
    "packageID": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "publisherID": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "packageSHA256": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" },
    "contentManifestSHA256": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" },
    "developerCertificateSHA256": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" },
    "auditLevel": { "enum": ["automated", "manual-standard", "manual-high-privilege"] },
    "channel": { "enum": ["stable", "beta", "security"] },
    "releaseSequence": { "type": "integer", "minimum": 1 },
    "minimumInflowBuild": { "type": "string", "minLength": 1, "maxLength": 64 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["Released", "Withdrawn", "Revoked"] },
    "revocationReasonCode": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "Revoked" } }, "required": ["status"] },
      "then": { "required": ["revocationReasonCode"] },
      "else": { "not": { "required": ["revocationReasonCode"] } }
    }
  ]
}
