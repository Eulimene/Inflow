{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inflow.local/schemas/render-manifest-v1.schema.json",
  "title": "Inflow generated RenderManifest v1",
  "type": "object",
  "properties": {
    "manifestVersion": { "const": 1 },
    "evidenceStatus": { "const": "passed" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "not": { "pattern": "^0{40}$" }
    },
    "releaseBuildID": { "type": "string", "minLength": 1, "maxLength": 256 },
    "platform": {
      "type": "object",
      "properties": {
        "minimumMacOS": { "type": "string", "pattern": "^[0-9]+(?:[.][0-9]+){1,2}$" },
        "architecture": { "const": "arm64" },
        "configuration": { "const": "Release" }
      },
      "required": ["minimumMacOS", "architecture", "configuration"],
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "componentID": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,127}$" },
          "version": { "type": "string", "minLength": 1, "maxLength": 256 },
          "sourceIdentity": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "licenseSPDX": { "type": "string", "minLength": 1, "maxLength": 128 },
          "compileOptionsSha256": { "$ref": "#/$defs/sha256" }
        },
        "required": ["componentID", "version", "sourceIdentity", "licenseSPDX", "compileOptionsSha256"],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/artifact" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "purpose": { "const": "js-runtime" },
              "kind": { "enum": ["executable", "dynamic-library"] },
              "sha256": { "$ref": "#/$defs/sha256" }
            },
            "required": ["purpose", "kind", "sha256"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "purpose": { "const": "dom-shim" },
              "kind": { "enum": ["javascript", "binary-resource"] },
              "sha256": { "$ref": "#/$defs/sha256" }
            },
            "required": ["purpose", "kind", "sha256"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "purpose": { "const": "render-worker" },
              "kind": { "const": "executable" },
              "sha256": { "$ref": "#/$defs/sha256" }
            },
            "required": ["purpose", "kind", "sha256"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "contracts": {
      "type": "object",
      "properties": {
        "markdownDialectManifestVersion": { "type": "integer", "minimum": 1 },
        "sanitizerManifestVersion": { "type": "integer", "minimum": 1 },
        "headingSlugContract": { "const": "github-compatible-heading-slug-v1" },
        "fragmentResolutionContract": { "const": "decode-nfc-once-exact-dom-id-v1" },
        "exportHTMLPolicy": { "const": "ExportHTMLPolicy-v1" },
        "pdfPostflightPolicy": { "const": "PDFPostflight-v1" },
        "renderIsolationPath": { "const": "one-shot-non-webkit-worker-v1" },
        "markdownParseOptionsRawValue": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "markdownDialectManifestVersion",
        "sanitizerManifestVersion",
        "headingSlugContract",
        "fragmentResolutionContract",
        "exportHTMLPolicy",
        "pdfPostflightPolicy",
        "renderIsolationPath",
        "markdownParseOptionsRawValue"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "compiledSanitizerAllowlist": { "$ref": "#/$defs/evidenceArtifact" },
        "sanitizerNegativeCorpusResults": { "$ref": "#/$defs/evidenceArtifact" },
        "goldenIndex": { "$ref": "#/$defs/evidenceArtifact" },
        "archiveEntitlementMatrix": { "$ref": "#/$defs/evidenceArtifact" },
        "processIsolationResults": { "$ref": "#/$defs/evidenceArtifact" },
        "resourceGovernorResults": { "$ref": "#/$defs/evidenceArtifact" },
        "pdfPostflightResults": { "$ref": "#/$defs/evidenceArtifact" }
      },
      "required": [
        "compiledSanitizerAllowlist",
        "sanitizerNegativeCorpusResults",
        "goldenIndex",
        "archiveEntitlementMatrix",
        "processIsolationResults",
        "resourceGovernorResults",
        "pdfPostflightResults"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "manifestVersion",
    "evidenceStatus",
    "generatedAt",
    "sourceRevision",
    "releaseBuildID",
    "platform",
    "components",
    "artifacts",
    "contracts",
    "evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": { "pattern": "^0{64}$" }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "allOf": [
        { "not": { "pattern": "^/" } },
        { "not": { "pattern": "^[A-Za-z]:" } },
        { "not": { "pattern": "(^|/)[.][.](/|$)" } }
      ]
    },
    "artifact": {
      "type": "object",
      "properties": {
        "artifactID": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" },
        "purpose": {
          "enum": [
            "markdown-parser",
            "mermaid-runtime",
            "katex-runtime",
            "katex-style",
            "katex-font",
            "js-runtime",
            "dom-shim",
            "render-worker",
            "preview-bridge",
            "theme",
            "app-font",
            "sanitizer-policy"
          ]
        },
        "kind": { "enum": ["executable", "dynamic-library", "javascript", "css", "font", "json", "binary-resource"] },
        "version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "packageRelativePath": { "$ref": "#/$defs/relativePath" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["artifactID", "purpose", "kind", "version", "packageRelativePath", "byteLength", "sha256"],
      "additionalProperties": false
    },
    "evidenceArtifact": {
      "type": "object",
      "properties": {
        "evidenceRelativePath": { "$ref": "#/$defs/relativePath" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "status": { "const": "passed" }
      },
      "required": ["evidenceRelativePath", "byteLength", "sha256", "status"],
      "additionalProperties": false
    }
  }
}
