  "additionalProperties": false,
  "$defs": {
    "mapping": {
      "type": "object",
      "required": [
        "requirementKind",
        "productPhase",
        "owner",
        "engineeringPhases",
        "evidenceRefs",
        "fixtureGroup",
        "evidenceStatus"
      ],
      "properties": {
        "requirementKind": {
          "enum": ["FEATURE", "DOD"]
        },
        "productPhase": {
          "enum": ["P0", "P1", "P2", "P3"]
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]+(?:\\.[A-Z][A-Za-z0-9]+)+$"
        },
        "engineeringPhases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["T0", "T1", "T2", "T3", "T4", "T5", "T6"]
          }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*\\*)(?!.*\\?)(?!.*\\[)(?!.*\\])[^\\r\\n]+$"
          }
        },
        "fixtureGroup": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]*$"
        },
        "evidenceStatus": {
          "enum": ["OPEN", "CONTRACT_FROZEN", "PASSED"]
        },
        "buildEvidence": {
          "$ref": "#/$defs/buildEvidence"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "evidenceStatus": { "const": "PASSED" }
            },
            "required": ["evidenceStatus"]
          },
          "then": {
            "required": ["buildEvidence"]
          },
          "else": {
            "not": {
              "required": ["buildEvidence"]
            }
          }
        }
      ]
    },
    "buildEvidence": {
      "type": "object",
      "required": [
        "releaseBuildSHA256",
        "fixtureManifestSHA256",
        "resultSHA256"
      ],
      "properties": {
        "releaseBuildSHA256": {
          "type": "string",
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        },
        "fixtureManifestSHA256": {
          "type": "string",
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        },
        "resultSHA256": {
          "type": "string",
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "p0Feature": {
      "allOf": [
        { "$ref": "#/$defs/mapping" },
        {
          "properties": {
            "requirementKind": { "const": "FEATURE" },
            "productPhase": { "const": "P0" }
          }
        }
      ]
    },
    "p0DoD": {
      "allOf": [
        { "$ref": "#/$defs/mapping" },
        {
          "properties": {
            "requirementKind": { "const": "DOD" },
            "productPhase": { "const": "P0" }
          }
        }
      ]
    },
    "p1Feature": {
      "allOf": [
        { "$ref": "#/$defs/mapping" },
        {
          "properties": {
            "requirementKind": { "const": "FEATURE" },
            "productPhase": { "const": "P1" }
          }
        }
      ]
    },
    "p1DoD": {
      "allOf": [
        { "$ref": "#/$defs/mapping" },
        {
          "properties": {
