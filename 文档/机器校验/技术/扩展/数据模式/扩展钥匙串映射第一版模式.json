{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inflow.local/extensions/extension-keychain-projection-v1.schema.json",
  "title": "Inflow Extension Keychain Projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "policyVersion", "authority", "normativeSource", "sharedAccessGroupRule", "wildcardAccessGroupRule", "accessGroups", "wrappedDEKs", "stores"],
  "properties": {
    "$schema": { "const": "./数据模式/扩展钥匙串映射第一版模式.json" },
    "policyVersion": { "const": 1 },
    "authority": { "const": "projection" },
    "normativeSource": { "const": "../核心/钥匙串策略.json" },
    "sharedAccessGroupRule": { "const": "forbidden-unless-exactly-listed" },
    "wildcardAccessGroupRule": { "const": "forbidden" },
    "accessGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "logicalAccessGroup", "targets", "secretClasses"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "logicalAccessGroup": { "type": "string", "pattern": "^com\\.inflow\\.[a-z0-9.-]+$" },
          "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
          "secretClasses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "wrappedDEKs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "kekRef", "dekScope", "rotationBoundary", "cryptoEraseTriggers"],
        "properties": {
          "domain": { "type": "string" },
          "kekRef": { "type": "string" },
          "dekScope": { "type": "string" },
          "rotationBoundary": { "type": "string" },
          "cryptoEraseTriggers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "stores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ownerTarget", "encryption", "encryptedFields", "extensionReadable", "deletionTriggers"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "ownerTarget": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "encryption": { "enum": ["full-record-aead", "encrypted-sqlite-wal-and-blobs"] },
          "encryptedFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "extensionReadable": { "type": "boolean" },
          "deletionTriggers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "stateContract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phases", "maximumBytes", "maximumPreferenceStringBytes", "allowedValueKinds", "freeFormStrings", "documentDerivedContent"],
            "properties": {
              "phases": { "const": ["E1", "E2"] },
              "maximumBytes": { "const": 65536 },
              "maximumPreferenceStringBytes": { "const": 256 },
              "allowedValueKinds": { "const": ["boolean", "bounded-number", "declared-enum", "bounded-preference-string"] },
              "freeFormStrings": { "const": false },
              "documentDerivedContent": { "const": false }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "id": { "const": "extension-state" } }, "required": ["id"] },
            "then": {
              "required": ["stateContract"],
              "properties": { "extensionReadable": { "const": true } }
            },
            "else": {
              "properties": { "extensionReadable": { "const": false } },
              "not": { "required": ["stateContract"] }
            }
          }
        ]
      }
    }
  }
}
