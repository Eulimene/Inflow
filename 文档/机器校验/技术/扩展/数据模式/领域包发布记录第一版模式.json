{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inflow.local/extensions/pack-release-record-v1.schema.json",
  "title": "Inflow PackReleaseRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordVersion", "packID", "publisherID", "packVersion", "channel", "releaseSequence", "issuedAt", "resolver", "components", "resolutionHash", "marketLogEntry"],
  "properties": {
    "recordVersion": { "const": 1 },
    "packID": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "publisherID": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "packVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "channel": { "enum": ["stable", "beta"] },
    "releaseSequence": { "type": "integer", "minimum": 1 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "inflowBuild", "extensionAPIVersion", "platform"],
      "properties": {
        "algorithm": { "const": "inflow-semver-sat-v1" },
        "inflowBuild": { "type": "string", "minLength": 1, "maxLength": 64 },
        "extensionAPIVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
        "platform": { "const": "macos-arm64" }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packageID", "publisherID", "version", "packageSHA256", "contentManifestSHA256", "publisherKeyID", "required", "capabilityRole", "artifacts"],
        "properties": {
          "packageID": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
          "publisherID": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
          "version": { "type": "string", "minLength": 1, "maxLength": 64 },
          "packageSHA256": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" },
          "contentManifestSHA256": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" },
          "publisherKeyID": { "type": "string", "minLength": 1, "maxLength": 128 },
          "required": { "type": "boolean" },
          "capabilityRole": { "enum": ["parser", "renderer", "diagnostic", "editor", "exporter", "theme", "metadata"] },
          "artifacts": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["assetPath", "sha256", "mediaType", "byteCount"],
              "properties": {
                "assetPath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001F\\u007F\\\\]+$", "maxLength": 512 },
                "sha256": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" },
                "mediaType": { "enum": ["image/svg+xml", "image/png"] },
                "byteCount": { "type": "integer", "minimum": 1, "maximum": 52428800 }
              }
            }
          }
        }
      }
    },
    "resolutionHash": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" },
    "marketLogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treeSize", "leafHash", "checkpointSequence"],
      "properties": {
        "treeSize": { "type": "integer", "minimum": 1 },
        "leafHash": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" },
        "checkpointSequence": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
