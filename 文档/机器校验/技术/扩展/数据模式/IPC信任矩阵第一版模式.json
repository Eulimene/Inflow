{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inflow.local/extensions/ipc-trust-matrix-v1.schema.json",
  "title": "Inflow IPC Trust Matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "matrixVersion", "authority", "requestEnvelope", "peerChecks", "listeners", "runtimeInvariants"],
  "properties": {
    "$schema": { "const": "./数据模式/IPC信任矩阵第一版模式.json" },
    "matrixVersion": { "const": 1 },
    "authority": { "const": "normative" },
    "requestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "requiredFields", "hashInput", "forbiddenAuthorityClaimsInBody", "unknownFieldRule", "replayRule", "expiryRule"],
      "properties": {
        "encoding": { "const": "canonical-cbor" },
        "requiredFields": { "const": ["protocolVersion", "requestID", "method", "deadlineUnixMillis", "connectionNonce", "sequence", "bodySHA256", "body"] },
        "hashInput": { "const": ["protocolVersion", "requestID", "method", "deadlineUnixMillis", "connectionNonce", "sequence", "bodySHA256"] },
        "forbiddenAuthorityClaimsInBody": { "const": ["extensionID", "pid", "auditToken", "uid", "auditSessionID"] },
        "unknownFieldRule": { "const": "reject" },
        "replayRule": { "type": "string", "minLength": 1 },
        "expiryRule": { "type": "string", "minLength": 1 }
      }
    },
    "peerChecks": { "const": ["designated-requirement", "team-identifier", "bundle-identifier", "audit-token", "effective-uid-equals-console-session-owner", "audit-session-equals-app-session", "connection-challenge-response", "request-body-hash", "deadline", "replay-cache"] },
    "listeners": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "authorizedPeers", "additionalChecks", "capability"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "target": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "authorizedPeers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
          "additionalChecks": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "capability": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "extension-manager-control" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "package-verifier-job" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "extension-host-control" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "local-capability-broker-api" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "market-broker-api" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "network-credential-broker-api" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "ai-model-manager-api" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "ai-model-store-publish" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "ai-model-store-lease" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "ai-inference-worker-control" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "render-image-helper-job" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "pdf-postflight-helper-job" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "runtimeInvariants": { "const": ["manifest-identifier-is-never-an-ipc-authority", "extension-handle-is-server-issued-and-connection-bound", "one-active-extension-handle-has-one-dedicated-manager-client-and-one-distinct-host-process", "no-listener-authorizes-from-request-body-identity", "all-capabilities-are-nonce-bound-expiring-and-single-purpose", "callbacks-use-the-originating-authenticated-connection-and-do-not-open-an-unlisted-reverse-listener"] }
  }
}
