{
  "$schema": "./数据模式/市场代理策略第一版模式.json",
  "policyVersion": 1,
  "authority": "normative",
  "phase": "E3",
  "origin": "https://market.inflow.app:443",
  "proxyRule": "system-and-custom-proxy-overrides-forbidden",
  "endpoints": [
    { "id": "catalog", "method": "GET", "pathTemplate": "/catalog", "responseKind": "signed-json" },
    { "id": "extension-detail", "method": "GET", "pathTemplate": "/extensions/{packageID}", "responseKind": "signed-json" },
    { "id": "package-download", "method": "GET", "pathTemplate": "/extensions/{packageID}/versions/{version}/download", "responseKind": "signed-package-stream" },
    { "id": "revocations", "method": "GET", "pathTemplate": "/revocations", "responseKind": "signed-json" },
    { "id": "reports", "method": "POST", "pathTemplate": "/reports", "responseKind": "unsigned-report-receipt" }
  ],
  "dns": {
    "resolveEachConnection": true,
    "pinResolvedAddressThroughTLS": true,
    "maximumAnswers": 8,
    "rejectAddressClasses": ["unspecified", "loopback", "private", "link-local", "multicast", "carrier-grade-nat", "documentation", "benchmark", "reserved", "unix-socket"]
  },
  "tls": {
    "minimumVersion": "TLS1.2",
    "systemTrustOnly": true,
    "hostnameVerification": true,
    "clientCertificates": false
  },
  "redirects": {
    "maximumHops": 0,
    "followServerReturnedURLs": false
  },
  "budgets": {
    "requestBodyBytes": 1048576,
    "responseCompressedBytes": 67108864,
    "responseDecompressedBytes": 268435456,
    "decompressionRatio": 20,
    "wallClockSeconds": 120,
    "requestsPerOperation": 64
  },
  "responseRules": {
    "acceptedContentTypes": ["application/json", "application/vnd.inflow.extension+zip"],
    "unknownFieldRule": "reject-for-signed-records",
    "signatureRequiredFor": ["catalog", "market-release-record", "pack-release-record", "revocation-list"],
    "packageStreamDestination": "bounded-read-only-stream-to-extension-manager"
  }
}
