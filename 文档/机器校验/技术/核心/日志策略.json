{
  "policyVersion": 1,
  "releaseEvidenceStatus": "OPEN",
  "unknownEventPolicy": "dropWholeEvent",
  "unknownFieldPolicy": "dropWholeEvent",
  "directLoggingOutsideFacade": "forbidden",
  "storage": {
    "relativeDirectory": "Library/Logs/Inflow/Operational",
    "directoryModeOctal": "0700",
    "fileModeOctal": "0600",
    "excludedFromBackup": true,
    "maxTotalBytes": 10485760,
    "maxFileCount": 5,
    "maxAgeSeconds": 259200,
    "maxEventBytes": 4096,
    "encoding": "canonical-json-lines-utf8-lf",
    "overflowPolicy": "deleteOldestWholeFileThenDropNewEvent"
  },
  "memoryBreadcrumbs": {
    "persistent": false,
    "maxEventCount": 200,
    "maxTotalBytes": 262144,
    "clearOnNormalExit": true,
    "sameFieldPolicyAsPersistentLog": true
  },
  "fieldDefinitions": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "eventID": {
      "type": "enum",
      "values": [
        "save.transaction",
        "recovery.operation",
        "render.job",
        "image.decode",
        "pdf.export",
        "localLink.open",
        "settings.migration",
        "security.policyViolation"
      ]
    },
    "buildRole": {
      "type": "enum",
      "values": [
        "main",
        "renderSupervisor",
        "renderWorker",
        "imageDecodeHelper",
        "pdfPostflightHelper",
        "storeOwner"
      ]
    },
    "productPhase": {
      "type": "enum",
      "values": ["P0", "P1", "P2", "P3", "E1", "E2", "E3", "E4"]
    },
    "operation": {
      "type": "enum",
      "values": [
        "save",
        "saveAs",
        "autosave",
        "prepare",
        "commit",
        "reconcile",
        "snapshot",
        "handoff",
        "cleanup",
        "mermaid",
        "katex",
        "png",
        "jpeg",
        "createPDF",
        "postflight",
        "markdown",
        "attachment",
        "v1ToV2",
        "policyCheck"
      ]
    },
    "outcomeCode": {
      "type": "enum",
      "values": ["succeeded", "failed", "cancelled", "blocked", "degraded", "conflict", "dropped"]
    },
    "reasonCode": {
      "type": "enum",
      "values": [
        "none",
        "unknown",
        "invalidInput",
        "invalidState",
        "staleGeneration",
        "targetChanged",
        "targetOwned",
        "permissionDenied",
        "keychainLocked",
        "keyMissing",
        "authenticationFailed",
        "quotaExceeded",
        "diskFull",
        "journalPending",
        "timeout",
        "cpuLimit",
        "rssLimit",
        "outputLimit",
        "nodeLimit",
        "processViolation",
        "schemaViolation",
        "policyViolation",
        "unsupportedType",
        "postflightRejected",
        "migrationFailed"
      ]
    },
    "durationBucket": {
      "type": "enum",
      "values": ["lt10ms", "10to49ms", "50to199ms", "200to999ms", "1to4s", "ge5s"]
    },
    "sizeBucket": {
      "type": "enum",
      "values": ["zero", "1to4KiB", "4to64KiB", "64KiBto1MiB", "1to25MiB", "25to100MiB", "gt100MiB"]
    },
    "countBucket": {
      "type": "enum",
      "values": ["zero", "one", "2to4", "5to16", "17to64", "gt64"]
    },
    "ephemeralCorrelationID": {
      "type": "uuid-v4",
      "derivation": "randomPerOperation",
      "maxLifetime": "process"
    },
    "policyVersion": {
      "type": "integer",
      "minimum": 1
    }
  },
  "events": {
    "save.transaction": {
      "allowedFields": ["schemaVersion", "eventID", "buildRole", "productPhase", "operation", "outcomeCode", "reasonCode", "durationBucket", "sizeBucket", "ephemeralCorrelationID"]
    },
    "recovery.operation": {
      "allowedFields": ["schemaVersion", "eventID", "buildRole", "productPhase", "operation", "outcomeCode", "reasonCode", "durationBucket", "sizeBucket", "countBucket", "ephemeralCorrelationID"]
    },
    "render.job": {
      "allowedFields": ["schemaVersion", "eventID", "buildRole", "productPhase", "operation", "outcomeCode", "reasonCode", "durationBucket", "sizeBucket", "countBucket", "ephemeralCorrelationID", "policyVersion"]
    },
    "image.decode": {
      "allowedFields": ["schemaVersion", "eventID", "buildRole", "productPhase", "operation", "outcomeCode", "reasonCode", "durationBucket", "sizeBucket", "ephemeralCorrelationID", "policyVersion"]
    },
    "pdf.export": {
      "allowedFields": ["schemaVersion", "eventID", "buildRole", "productPhase", "operation", "outcomeCode", "reasonCode", "durationBucket", "sizeBucket", "countBucket", "ephemeralCorrelationID", "policyVersion"]
    },
    "localLink.open": {
      "allowedFields": ["schemaVersion", "eventID", "buildRole", "productPhase", "operation", "outcomeCode", "reasonCode", "ephemeralCorrelationID", "policyVersion"]
    },
    "settings.migration": {
      "allowedFields": ["schemaVersion", "eventID", "buildRole", "productPhase", "operation", "outcomeCode", "reasonCode", "durationBucket", "countBucket", "ephemeralCorrelationID", "policyVersion"]
    },
    "security.policyViolation": {
      "allowedFields": ["schemaVersion", "eventID", "buildRole", "productPhase", "operation", "outcomeCode", "reasonCode", "countBucket", "ephemeralCorrelationID", "policyVersion"]
    }
  },
  "forbiddenFieldClasses": [
    "documentOrRenderedContent",
    "htmlPdfOrImageBytes",
    "absoluteOrRelativePath",
    "fileName",
    "urlFragmentOrHeading",
    "bookmarkOrSecurityScope",
    "selectionScrollOrWindowState",
    "promptResponseOrDiff",
    "clipboard",
    "rawOrContentHash",
    "stableDocumentWorkspaceSessionExtensionOrAccountID",
    "keychainItemOrKeyMaterial",
    "commandLineEnvironmentOrProcessTitle",
    "localizedOrUnderlyingErrorDescription"
  ],
  "canaryScanner": {
    "evidenceStatus": "OPEN",
    "canaryGeneration": "randomHighEntropyPerRunAndDataClass",
    "reportStoresCanary": false,
    "requiredRepresentations": [
      "utf8",
      "utf16le",
      "utf16be",
      "unicodeNFC",
      "unicodeNFD",
      "jsonEscaped",
      "percentEncodedOnce",
      "percentEncodedTwice",
      "base64Standard",
      "base64URLSafe",
      "hex",
      "productCompressionFraming"
    ],
    "requiredRoots": [
      "appContainer",
      "sqliteWalAndShm",
      "recoveryStateSyncAndAISessionStores",
      "expiredOrStartupCleanedLinkOpenClones",
      "capturedUnifiedLog",
      "crashReportsAndDiagnosticAttachments",
      "helperStdoutAndStderr",
      "appOwnedTempAndReplacementResidue",
      "pdfAndPrintSpoolFixture"
    ],
    "excludedRoots": ["userSourceMarkdown", "userCommittedExportTarget", "activeLinkOpenCloneWithinLease"],
    "unreadableRootPolicy": "fail",
    "skippedRepresentationPolicy": "fail",
    "matchPolicy": "fail",
    "requiredMatchCount": 0
  }
}
