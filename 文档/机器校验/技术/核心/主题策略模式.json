{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inflow.local/schemas/theme-policy-v1.schema.json",
  "title": "Inflow restricted ThemePackage manifest v1",
  "$comment": "E1 only exposes Core-owned design-token selection. Third-party packages validated by this schema are unavailable before P2. Unknown fields and all raw CSS/HTML/SVG/script/image resources are rejected.",
  "type": "object",
  "properties": {
    "policyVersion": { "const": 1 },
    "capability": { "const": "design-tokens-v1" },
    "availableFrom": { "const": "P2" },
    "themeID": { "type": "string", "pattern": "^[a-z0-9]+(?:[.][a-z0-9-]+){2,15}$" },
    "publisherID": { "type": "string", "pattern": "^[a-z0-9]+(?:[.][a-z0-9-]+){2,15}$" },
    "version": { "type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "releaseSequence": { "type": "integer", "minimum": 1 },
    "minimumAppReleaseSequence": { "type": "integer", "minimum": 1 },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "variantID": { "enum": ["light", "dark", "highContrast"] },
          "tokens": { "$ref": "#/$defs/tokens" }
        },
        "required": ["variantID", "tokens"],
        "additionalProperties": false
      }
    },
    "fontArtifacts": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/fontArtifact" }
    },
    "forbiddenCapabilities": {
      "type": "array",
      "const": ["raw-css", "html", "svg", "script", "network", "images", "url-resources", "font-runtime-code"]
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "required": [
    "policyVersion",
    "capability",
    "availableFrom",
    "themeID",
    "publisherID",
    "version",
    "releaseSequence",
    "minimumAppReleaseSequence",
    "variants",
    "fontArtifacts",
    "forbiddenCapabilities",
    "signature"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": { "pattern": "^0{64}$" }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"
    },
    "fontRef": {
      "type": "string",
      "pattern": "^(?:system-ui|system-monospace|font:[a-z][a-z0-9._-]{1,127})$"
    },
    "tokens": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "object",
          "properties": {
            "canvas": { "$ref": "#/$defs/color" },
            "surface": { "$ref": "#/$defs/color" },
            "textPrimary": { "$ref": "#/$defs/color" },
            "textSecondary": { "$ref": "#/$defs/color" },
            "heading": { "$ref": "#/$defs/color" },
            "link": { "$ref": "#/$defs/color" },
            "linkVisited": { "$ref": "#/$defs/color" },
            "border": { "$ref": "#/$defs/color" },
            "selection": { "$ref": "#/$defs/color" },
            "codeForeground": { "$ref": "#/$defs/color" },
            "codeBackground": { "$ref": "#/$defs/color" },
            "quoteBorder": { "$ref": "#/$defs/color" },
            "error": { "$ref": "#/$defs/color" }
          },
          "required": [
            "canvas",
            "surface",
            "textPrimary",
            "textSecondary",
            "heading",
            "link",
            "linkVisited",
            "border",
            "selection",
            "codeForeground",
            "codeBackground",
            "quoteBorder",
            "error"
          ],
          "additionalProperties": false
        },
        "typography": {
          "type": "object",
          "properties": {
            "bodyFont": { "$ref": "#/$defs/fontRef" },
            "headingFont": { "$ref": "#/$defs/fontRef" },
            "codeFont": { "$ref": "#/$defs/fontRef" },
            "bodyWeight": { "type": "integer", "enum": [300, 400, 500, 600, 700] },
            "headingWeight": { "type": "integer", "enum": [400, 500, 600, 700] },
            "lineHeight": { "type": "number", "minimum": 1.2, "maximum": 2.0 },
            "codeLineHeight": { "type": "number", "minimum": 1.1, "maximum": 2.0 }
          },
          "required": ["bodyFont", "headingFont", "codeFont", "bodyWeight", "headingWeight", "lineHeight", "codeLineHeight"],
          "additionalProperties": false
        },
        "layout": {
          "type": "object",
          "properties": {
            "paragraphSpacingEm": { "type": "number", "minimum": 0.25, "maximum": 3.0 },
            "headingSpacingBeforeEm": { "type": "number", "minimum": 0.25, "maximum": 4.0 },
            "headingSpacingAfterEm": { "type": "number", "minimum": 0.1, "maximum": 2.0 },
            "codeBlockPaddingEm": { "type": "number", "minimum": 0.25, "maximum": 2.0 },
            "borderWidthPx": { "type": "number", "minimum": 0, "maximum": 4 },
            "cornerRadiusPx": { "type": "number", "minimum": 0, "maximum": 24 }
          },
          "required": [
            "paragraphSpacingEm",
            "headingSpacingBeforeEm",
            "headingSpacingAfterEm",
            "codeBlockPaddingEm",
            "borderWidthPx",
            "cornerRadiusPx"
          ],
          "additionalProperties": false
        }
      },
      "required": ["colors", "typography", "layout"],
      "additionalProperties": false
    },
    "relativeFontPath": {
      "type": "string",
      "pattern": "^fonts/[A-Za-z0-9][A-Za-z0-9._-]{0,127}[.](?:otf|ttf|woff2)$",
      "not": { "pattern": "[.][.]" }
    },
    "fontArtifact": {
      "type": "object",
      "properties": {
        "fontID": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" },
        "packageRelativePath": { "$ref": "#/$defs/relativeFontPath" },
        "mediaType": { "enum": ["font/otf", "font/ttf", "font/woff2"] },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "faceCount": { "type": "integer", "minimum": 1, "maximum": 8 },
        "glyphCount": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "fontDecodePolicyVersion": { "const": 1 },
        "isolatedDecodeEvidenceSha256": { "$ref": "#/$defs/sha256" }
      },
      "required": [
        "fontID",
        "packageRelativePath",
        "mediaType",
        "byteLength",
        "sha256",
        "faceCount",
        "glyphCount",
        "fontDecodePolicyVersion",
        "isolatedDecodeEvidenceSha256"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "canonicalization": { "const": "RFC8785-JCS-with-signature-field-omitted" },
        "publisherKeyID": { "type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$" },
        "payloadSha256": { "$ref": "#/$defs/sha256" },
        "signatureBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      },
      "required": ["algorithm", "canonicalization", "publisherKeyID", "payloadSha256", "signatureBase64"],
      "additionalProperties": false
    }
  }
}
