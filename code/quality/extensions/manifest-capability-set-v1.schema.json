{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inflow.app/extensions/capability-set/v1",
  "title": "Inflow Manifest Capability Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requiredCapabilities",
    "optionalCapabilities",
    "componentCapabilities"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requiredCapabilities": { "$ref": "#/$defs/capabilityArray" },
    "optionalCapabilities": { "$ref": "#/$defs/capabilityArray" },
    "componentCapabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "componentID",
          "kind",
          "imports",
          "syntaxNamespaces",
          "attributePolicies"
        ],
        "properties": {
          "componentID": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "kind": {
            "enum": [
              "wasm-command",
              "syntax-provider",
              "declarative-view",
              "asset"
            ]
          },
          "imports": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "enum": [
                "host.text.selection.read",
                "host.suggestion.emit",
                "host.diagnostic.emit",
                "host.syntax.node.emit",
                "host.view.tree.emit",
                "host.export.tree.emit",
                "host.task.cancelled",
                "host.log.redacted"
              ]
            }
          },
          "syntaxNamespaces": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/namespace" }
          },
          "attributePolicies": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["namespace", "sha256"],
              "properties": {
                "namespace": { "$ref": "#/$defs/namespace" },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "capabilityArray": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "selected-text.read",
          "selected-text.suggest",
          "document.diagnose",
          "syntax.directive",
          "syntax.fenced-block",
          "declarative-view.present",
          "export.declarative"
        ]
      }
    },
    "namespace": {
      "type": "string",
      "pattern": "^inflow:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+:[a-z][a-z0-9-]{0,63}$",
      "maxLength": 232
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[a-f0-9]{64}$"
    }
  }
}
