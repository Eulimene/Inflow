{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inflow.app/extensions/syntax-attribute-policy/v1",
  "title": "Inflow Syntax Attribute Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyType",
    "namespace",
    "properties",
    "requiredProperties"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyType": { "const": "syntax-attributes" },
    "namespace": {
      "type": "string",
      "pattern": "^inflow:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+:[a-z][a-z0-9-]{0,63}$",
      "maxLength": 232
    },
    "properties": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/propertyPolicy" }
    },
    "requiredProperties": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
    }
  },
  "$defs": {
    "stringPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "minLength", "maxLength"],
      "properties": {
        "kind": { "const": "string" },
        "minLength": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "maxLength": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "allowedValues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 4096 }
        }
      }
    },
    "numberPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "minimum", "maximum"],
      "properties": {
        "kind": { "const": "number" },
        "minimum": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 },
        "maximum": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 },
        "allowedValues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 }
        }
      }
    },
    "booleanPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "boolean" }
      }
    },
    "stringArrayPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "maxItems", "itemMaxLength"],
      "properties": {
        "kind": { "const": "string-array" },
        "maxItems": { "type": "integer", "minimum": 0, "maximum": 64 },
        "itemMaxLength": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "allowedValues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 4096 }
        }
      }
    },
    "propertyPolicy": {
      "oneOf": [
        { "$ref": "#/$defs/stringPolicy" },
        { "$ref": "#/$defs/numberPolicy" },
        { "$ref": "#/$defs/booleanPolicy" },
        { "$ref": "#/$defs/stringArrayPolicy" }
      ]
    }
  }
}
