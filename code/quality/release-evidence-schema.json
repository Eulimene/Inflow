{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inflow:schema:release-evidence:v1",
  "title": "Inflow release evidence receipts",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "evidence_kind", "status", "source_head", "dirty", "mode",
        "created_at_utc", "xcode", "rust", "rust_format_passed", "rust_clippy_passed",
        "rust_tests_passed", "rust_test_count", "rust_format_log_sha256",
        "rust_clippy_log_sha256", "rust_test_log_sha256", "macos_tests_passed",
        "macos_test_count", "macos_failed_test_count", "macos_skipped_test_count",
        "debug_xcresult_sha256", "analyze_passed", "analyze_xcresult_sha256",
        "repository_performance_smoke_passed", "repository_performance_test_count",
        "repository_performance_failed_test_count", "repository_performance_skipped_test_count",
        "performance_xcresult_sha256", "performance_manifest_sha256",
        "authoritative_target_performance_complete", "archive_verified", "archive_zip_sha256",
        "verify_launch_script_sha256", "verify_archive_script_sha256",
        "release_workflow_script_sha256", "project_file_sha256", "cargo_lock_sha256",
        "cargo_toml_sha256", "rust_toolchain_sha256", "app_source_head", "app_bundle_id",
        "app_marketing_version", "app_build_version", "app_release_profile",
        "manual_update_url_sha256", "app_info_plist_sha256", "app_binary_sha256",
        "app_cdhash", "app_team_id", "app_signing_authority",
        "app_signing_certificate_sha256", "app_signing_certificate_subject_rfc2253",
        "app_entitlements_sha256", "app_privacy_manifest_sha256",
        "verification_signer_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "evidence_kind": { "const": "inflow-launch-verification" },
        "status": { "const": "passed" },
        "source_head": { "$ref": "#/$defs/git_oid" },
        "dirty": { "const": false },
        "mode": { "const": "signed" },
        "created_at_utc": { "type": "string", "format": "date-time" },
        "xcode": { "type": "string", "minLength": 1 },
        "rust": { "type": "string", "minLength": 1 },
        "rust_format_passed": { "const": true },
        "rust_clippy_passed": { "const": true },
        "rust_tests_passed": { "const": true },
        "rust_test_count": { "type": "integer", "minimum": 150 },
        "rust_format_log_sha256": { "$ref": "#/$defs/sha256" },
        "rust_clippy_log_sha256": { "$ref": "#/$defs/sha256" },
        "rust_test_log_sha256": { "$ref": "#/$defs/sha256" },
        "macos_tests_passed": { "const": true },
        "macos_test_count": { "type": "integer", "minimum": 300 },
        "macos_failed_test_count": { "const": 0 },
        "macos_skipped_test_count": { "const": 0 },
        "debug_xcresult_sha256": { "$ref": "#/$defs/sha256" },
        "analyze_passed": { "const": true },
        "analyze_xcresult_sha256": { "$ref": "#/$defs/sha256" },
        "repository_performance_smoke_passed": { "const": true },
        "repository_performance_test_count": { "const": 1 },
        "repository_performance_failed_test_count": { "const": 0 },
        "repository_performance_skipped_test_count": { "const": 0 },
        "performance_xcresult_sha256": { "$ref": "#/$defs/sha256" },
        "performance_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "authoritative_target_performance_complete": { "const": false },
        "archive_verified": { "const": true },
        "archive_zip_sha256": { "$ref": "#/$defs/sha256" },
        "verify_launch_script_sha256": { "$ref": "#/$defs/sha256" },
        "verify_archive_script_sha256": { "$ref": "#/$defs/sha256" },
        "release_workflow_script_sha256": { "$ref": "#/$defs/sha256" },
        "project_file_sha256": { "$ref": "#/$defs/sha256" },
        "cargo_lock_sha256": { "$ref": "#/$defs/sha256" },
        "cargo_toml_sha256": { "$ref": "#/$defs/sha256" },
        "rust_toolchain_sha256": { "$ref": "#/$defs/sha256" },
        "app_source_head": { "$ref": "#/$defs/git_oid" },
        "app_bundle_id": { "const": "com.inflow.desktop" },
        "app_marketing_version": { "type": "string", "minLength": 1 },
        "app_build_version": { "type": "string", "minLength": 1 },
        "app_release_profile": { "const": "signed-preview" },
        "manual_update_url_sha256": { "$ref": "#/$defs/sha256" },
        "app_info_plist_sha256": { "$ref": "#/$defs/sha256" },
        "app_binary_sha256": { "$ref": "#/$defs/sha256" },
        "app_cdhash": { "type": "string", "pattern": "^[0-9A-Fa-f]{40}([0-9A-Fa-f]{24})?$" },
        "app_team_id": { "type": "string", "pattern": "^[A-Za-z0-9]+$" },
        "app_signing_authority": { "type": "string", "pattern": "^Developer ID Application:" },
        "app_signing_certificate_sha256": { "$ref": "#/$defs/sha256" },
        "app_signing_certificate_subject_rfc2253": { "type": "string", "minLength": 1 },
        "app_entitlements_sha256": { "$ref": "#/$defs/sha256" },
        "app_privacy_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "verification_signer_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "product_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "baseline_id",
        "source_head",
        "document_set_sha256",
        "approver_id",
        "approved_at_utc"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "status": { "const": "approved" },
        "baseline_id": { "type": "string", "minLength": 1 },
        "source_head": { "$ref": "#/$defs/git_oid" },
        "document_set_sha256": { "$ref": "#/$defs/sha256" },
        "approver_id": { "type": "string", "minLength": 1 },
        "approved_at_utc": { "type": "string", "format": "date-time" }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "source_head",
        "dirty",
        "manifest_sha256",
        "model_identifier",
        "physical_memory_bytes",
        "macos_version",
        "macos_build",
        "architecture",
        "text_fixture_sha256",
        "text_fixture_bytes",
        "text_fixture_lines",
        "structure_fixture_sha256",
        "image_count",
        "image_total_bytes",
        "image_corpus_sha256",
        "full_fixture_sha256",
        "full_fixture_status",
        "warmup_runs",
        "measured_runs",
        "device_restarted",
        "post_restart_wait_seconds",
        "other_foreground_apps_closed",
        "cold_inflow_exited",
        "cold_minimum_not_running_seconds",
        "cold_start_event",
        "warm_inflow_state",
        "warm_idle_seconds",
        "warm_start_event",
        "latency_sample_count",
        "resource_sample_window_seconds",
        "continuous_input_duration_seconds",
        "statistics_complete",
        "process_tree_complete",
        "preview_update_p95_milliseconds",
        "view_switch_maximum_milliseconds",
        "input_pause_p95_milliseconds",
        "input_pause_maximum_milliseconds",
        "blank_window_median_milliseconds",
        "blank_window_maximum_milliseconds",
        "warm_open_median_milliseconds",
        "warm_open_p95_milliseconds",
        "cold_open_median_milliseconds",
        "cold_open_maximum_milliseconds",
        "aggregate_rss_peak_bytes",
        "aggregate_cpu_window_percent",
        "raw_samples_sha256",
        "statistics_sha256",
        "process_tree_sha256",
        "authoritative_latency_samples_complete"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "status": { "const": "passed" },
        "source_head": { "$ref": "#/$defs/git_oid" },
        "dirty": { "const": false },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "model_identifier": { "const": "MacBookAir10,1" },
        "physical_memory_bytes": { "const": 8589934592 },
        "macos_version": { "const": "14.0" },
        "macos_build": { "type": "string", "minLength": 1 },
        "architecture": { "const": "arm64" },
        "text_fixture_sha256": { "$ref": "#/$defs/sha256" },
        "text_fixture_bytes": { "const": 1048576 },
        "text_fixture_lines": { "const": 10000 },
        "structure_fixture_sha256": { "$ref": "#/$defs/sha256" },
        "image_count": { "const": 20 },
        "image_total_bytes": { "const": 16777216 },
        "image_corpus_sha256": { "$ref": "#/$defs/sha256" },
        "full_fixture_sha256": { "$ref": "#/$defs/sha256" },
        "full_fixture_status": { "const": "passed" },
        "warmup_runs": { "const": 3 },
        "measured_runs": { "const": 30 },
        "device_restarted": { "const": true },
        "post_restart_wait_seconds": { "const": 300 },
        "other_foreground_apps_closed": { "const": true },
        "cold_inflow_exited": { "const": true },
        "cold_minimum_not_running_seconds": { "const": 30 },
        "cold_start_event": { "const": "finder-open-request-for-benchmark-document" },
        "warm_inflow_state": { "const": "one-blank-window" },
        "warm_idle_seconds": { "const": 10 },
        "warm_start_event": { "const": "user-confirms-open-file" },
        "latency_sample_count": { "const": 30 },
        "resource_sample_window_seconds": { "const": 30 },
        "continuous_input_duration_seconds": { "const": 60 },
        "statistics_complete": { "const": true },
        "process_tree_complete": { "const": true },
        "preview_update_p95_milliseconds": { "type": "number", "minimum": 0 },
        "view_switch_maximum_milliseconds": { "type": "number", "minimum": 0 },
        "input_pause_p95_milliseconds": { "type": "number", "minimum": 0 },
        "input_pause_maximum_milliseconds": { "type": "number", "minimum": 0 },
        "blank_window_median_milliseconds": { "type": "number", "minimum": 0 },
        "blank_window_maximum_milliseconds": { "type": "number", "minimum": 0 },
        "warm_open_median_milliseconds": { "type": "number", "minimum": 0 },
        "warm_open_p95_milliseconds": { "type": "number", "minimum": 0 },
        "cold_open_median_milliseconds": { "type": "number", "minimum": 0 },
        "cold_open_maximum_milliseconds": { "type": "number", "minimum": 0 },
        "aggregate_rss_peak_bytes": { "type": "integer", "minimum": 1 },
        "aggregate_cpu_window_percent": { "type": "number", "minimum": 0 },
        "raw_samples_sha256": { "$ref": "#/$defs/sha256" },
        "statistics_sha256": { "$ref": "#/$defs/sha256" },
        "process_tree_sha256": { "$ref": "#/$defs/sha256" },
        "authoritative_latency_samples_complete": { "const": true }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/verification" },
    { "$ref": "#/$defs/product_baseline" },
    { "$ref": "#/$defs/performance" }
  ]
}
