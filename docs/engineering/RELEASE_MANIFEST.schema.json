{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inflow.local/schemas/release-manifest-v1.schema.json",
  "title": "Inflow signed monotonic ReleaseManifest envelope v1",
  "$comment": "Cross-record rules are mandatory but not expressible in JSON Schema: releaseSequence must increase by one from the locally trusted record, previousManifestSha256 must match that record, minimumSafeReleaseSequence may never decrease, and an active subject release must not be revoked by any later trusted record.",
  "type": "object",
  "properties": {
    "payload": { "$ref": "#/$defs/payload" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "required": ["payload", "signature"],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": { "pattern": "^0{64}$" }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "allOf": [
        { "not": { "pattern": "^/" } },
        { "not": { "pattern": "^[A-Za-z]:" } },
        { "not": { "pattern": "(^|/)[.][.](/|$)" } }
      ]
    },
    "artifact": {
      "type": "object",
      "properties": {
        "artifactID": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" },
        "role": {
          "enum": ["notarized-app", "dmg", "zip", "installer", "update-payload", "detached-evidence-bundle"]
        },
        "packageRelativePath": { "$ref": "#/$defs/relativePath" },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 256 },
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "codeSigningIdentitySha256": { "$ref": "#/$defs/sha256" },
        "notarizationTicketSha256": { "$ref": "#/$defs/sha256" }
      },
      "required": [
        "artifactID",
        "role",
        "packageRelativePath",
        "mediaType",
        "byteLength",
        "sha256",
        "codeSigningIdentitySha256",
        "notarizationTicketSha256"
      ],
      "additionalProperties": false
    },
    "evidenceArtifact": {
      "type": "object",
      "properties": {
        "packageRelativePath": { "$ref": "#/$defs/relativePath" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "status": { "const": "passed" }
      },
      "required": ["packageRelativePath", "byteLength", "sha256", "status"],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 1 },
        "productID": { "const": "com.inflow.macos" },
        "channel": { "enum": ["stable", "beta", "security"] },
        "releaseSequence": { "type": "integer", "minimum": 1 },
        "subjectReleaseSequence": { "type": "integer", "minimum": 1 },
        "previousManifestSha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "minimumSafeReleaseSequence": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["active", "revoked"] },
        "version": { "type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "buildNumber": { "type": "string", "pattern": "^[1-9][0-9]{0,17}$" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "sbom": {
          "type": "object",
          "properties": {
            "format": { "enum": ["SPDX-2.3", "CycloneDX-1.6"] },
            "artifact": { "$ref": "#/$defs/evidenceArtifact" }
          },
          "required": ["format", "artifact"],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "predicateType": { "type": "string", "minLength": 1, "maxLength": 512 },
            "builderIdentity": { "type": "string", "minLength": 1, "maxLength": 512 },
            "reproducibleInputsSha256": { "$ref": "#/$defs/sha256" },
            "artifact": { "$ref": "#/$defs/evidenceArtifact" }
          },
          "required": ["predicateType", "builderIdentity", "reproducibleInputsSha256", "artifact"],
          "additionalProperties": false
        },
        "vulnerabilityGate": {
          "type": "object",
          "properties": {
            "status": { "const": "passed" },
            "policySha256": { "$ref": "#/$defs/sha256" },
            "advisoryDatabaseSnapshotSha256": { "$ref": "#/$defs/sha256" },
            "scannerArtifact": { "$ref": "#/$defs/evidenceArtifact" },
            "resultArtifact": { "$ref": "#/$defs/evidenceArtifact" },
            "unapprovedBlockingFindingCount": { "const": 0 }
          },
          "required": [
            "status",
            "policySha256",
            "advisoryDatabaseSnapshotSha256",
            "scannerArtifact",
            "resultArtifact",
            "unapprovedBlockingFindingCount"
          ],
          "additionalProperties": false
        },
        "t0Evidence": {
          "type": "object",
          "properties": {
            "markdownDialectManifest": { "$ref": "#/$defs/evidenceArtifact" },
            "renderManifest": { "$ref": "#/$defs/evidenceArtifact" },
            "sanitizerEvidence": { "$ref": "#/$defs/evidenceArtifact" },
            "renderIsolationEvidence": { "$ref": "#/$defs/evidenceArtifact" },
            "saveRecoveryEvidence": { "$ref": "#/$defs/evidenceArtifact" },
            "pdfPostflightEvidence": { "$ref": "#/$defs/evidenceArtifact" },
            "performanceEvidence": { "$ref": "#/$defs/evidenceArtifact" },
            "archiveEntitlementMatrix": { "$ref": "#/$defs/evidenceArtifact" },
            "keychainPolicy": { "$ref": "#/$defs/evidenceArtifact" },
            "loggingCanaryEvidence": { "$ref": "#/$defs/evidenceArtifact" }
          },
          "required": [
            "markdownDialectManifest",
            "renderManifest",
            "sanitizerEvidence",
            "renderIsolationEvidence",
            "saveRecoveryEvidence",
            "pdfPostflightEvidence",
            "performanceEvidence",
            "archiveEntitlementMatrix",
            "keychainPolicy",
            "loggingCanaryEvidence"
          ],
          "additionalProperties": false
        },
        "revocation": {
          "type": "object",
          "properties": {
            "reasonCode": {
              "enum": ["compromisedSigningKey", "knownExploitableVulnerability", "maliciousArtifact", "invalidProvenance", "policyViolation", "otherSecurityReason"]
            },
            "effectiveAt": { "type": "string", "format": "date-time" },
            "replacementReleaseSequence": { "type": ["integer", "null"], "minimum": 1 },
            "publicNoticeSha256": { "$ref": "#/$defs/sha256" }
          },
          "required": ["reasonCode", "effectiveAt", "replacementReleaseSequence", "publicNoticeSha256"],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "productID",
        "channel",
        "releaseSequence",
        "subjectReleaseSequence",
        "previousManifestSha256",
        "minimumSafeReleaseSequence",
        "status",
        "version",
        "buildNumber",
        "issuedAt",
        "sourceRevision",
        "artifacts",
        "sbom",
        "provenance",
        "vulnerabilityGate",
        "t0Evidence"
      ],
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "revoked" } }, "required": ["status"] },
          "then": { "required": ["revocation"] },
          "else": { "not": { "required": ["revocation"] } }
        }
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "canonicalization": { "const": "RFC8785-JCS" },
        "keyID": { "type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$" },
        "payloadSha256": { "$ref": "#/$defs/sha256" },
        "signatureBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      },
      "required": ["algorithm", "canonicalization", "keyID", "payloadSha256", "signatureBase64"],
      "additionalProperties": false
    }
  }
}
