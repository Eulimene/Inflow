{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inflow.local/extensions/phase-process-matrix-v2.schema.json",
  "title": "Inflow Extension Phase/Process Matrix v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "matrixVersion", "authority", "phases", "targets", "ciInvariants"],
  "properties": {
    "$schema": { "const": "./schemas/phase-process-matrix-v2.schema.json" },
    "matrixVersion": { "const": 2 },
    "authority": { "const": "normative" },
    "phases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capabilities", "distributionBoundary"],
        "properties": {
          "id": { "enum": ["E0", "E1", "E2", "E3", "E4", "E5"] },
          "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
          "distributionBoundary": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "E0" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "E1" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "E2" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "E3" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "E4" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "E5" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "introducedIn", "instanceModel", "plaintext", "fileAccess", "network", "keychainPolicyRefs", "responsibilities"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "displayName": { "type": "string", "minLength": 1 },
          "introducedIn": { "enum": ["CORE", "E0", "E1", "E2", "E3", "E4", "E5"] },
          "instanceModel": { "type": "string", "minLength": 1 },
          "plaintext": { "type": "string", "minLength": 1 },
          "fileAccess": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "network": { "type": "string", "minLength": 1 },
          "keychainPolicyRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
          "responsibilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "mustNotAccess": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "runtimeEvidence": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "ciInvariants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
  }
}
