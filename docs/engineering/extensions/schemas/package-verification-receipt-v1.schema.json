{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inflow.local/extensions/package-verification-receipt-v1.schema.json",
  "title": "Inflow Package VerificationReceipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptVersion", "jobID", "sourceIdentity", "casRootIdentity", "packageSHA256", "contentManifestSHA256", "payloadEntries", "scanPolicySHA256", "trustSnapshotSHA256", "issuedAt", "expiresAt"],
  "properties": {
    "receiptVersion": { "const": 1 },
    "jobID": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,128}$" },
    "sourceIdentity": { "$ref": "#/$defs/resourceIdentity" },
    "casRootIdentity": { "$ref": "#/$defs/resourceIdentity" },
    "packageSHA256": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" },
    "contentManifestSHA256": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" },
    "payloadEntries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "byteCount", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001F\\u007F\\\\]+$", "maxLength": 512 },
          "byteCount": { "type": "integer", "minimum": 0, "maximum": 52428800 },
          "sha256": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" }
        }
      }
    },
    "scanPolicySHA256": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" },
    "trustSnapshotSHA256": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "resourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volumeID", "fileID", "generation", "byteCount"],
      "properties": {
        "volumeID": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fileID": { "type": "string", "minLength": 1, "maxLength": 128 },
        "generation": { "type": "string", "minLength": 1, "maxLength": 128 },
        "byteCount": { "type": "integer", "minimum": 0, "maximum": 52428800 }
      }
    }
  }
}
